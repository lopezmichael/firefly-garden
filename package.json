{
  "name": "firefly-garden",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json && tsc -p apps/game/e2e/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build -w @firefly/game",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run check:bundle",
    "dev": "npm run dev -w @firefly/game",
    "prepare": "node scripts/install-hooks.mjs",
    "levels": "node scripts/generate-levels.ts",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
